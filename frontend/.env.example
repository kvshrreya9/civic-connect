# Copy to frontend/.env (optional). All values have safe defaults.

# Leave empty to use the Vite dev proxy (/api -> backend). Set an absolute URL for a separate API host.
VITE_API_URL=
# Where the dev proxy forwards /api requests
VITE_PROXY_TARGET=http://127.0.0.1:5000
# Default map centre when geolocation is unavailable
VITE_DEFAULT_LAT=13.0827
VITE_DEFAULT_LNG=80.2707
VITE_CITY_NAME=Your City
# Register the offline service worker during `npm run dev` (always on in production builds)
VITE_ENABLE_SW=false
