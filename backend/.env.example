# Copy to backend/.env (keep your existing .env if you already have one) and fill in real values.
# Never commit backend/.env.

FLASK_APP=run.py
FLASK_DEBUG=1
APP_ENV=development

# Either a full URL ...
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/civicconnect
# ... or the individual parts (used only when DATABASE_URL is empty)
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicconnect

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string
JWT_EXPIRES_HOURS=12

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=true
UPLOAD_FOLDER=
MAX_UPLOAD_MB=30
ENABLE_FACE_BLUR=true

# Free OpenStreetMap Nominatim geocoder (no API key). Set false to work fully offline.
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=CivicConnect/1.0 (contact: you@example.com)

PERIODIC_SYNC_MINUTES=10
IMAGE_URL_TTL_SECONDS=21600

# Related reports: same category within this radius (metres), counted per unique citizen
RELATED_RADIUS_M=200
RELATED_WINDOW_DAYS=60
WIDESPREAD_REPORT_THRESHOLD=5

# Rule-based risk classification (see docs/risk-and-alerts.md)
RISK_CRITICAL_POINTS=5
RISK_HIGH_POINTS=3
RISK_MEDIUM_POINTS=2
RISK_AFFECTED_THRESHOLD=50
RISK_RELATED_THRESHOLD=3
DEFAULT_CRITICAL_RESPONSE_MINUTES=60
DEFAULT_HIGH_RESPONSE_MINUTES=240
DEADLINE_WARNING_HOURS=12

# Optional external alert channels (in-app alerts work without these).
# "accepted" in the audit log means the provider accepted the message - not confirmed delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Optional Twilio Voice calls for administrators on new critical alerts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEMO_CENTER_LAT=13.0827
DEMO_CENTER_LNG=80.2707
DEMO_PASSWORD=CivicDemo@2026
